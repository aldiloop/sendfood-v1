# Salin file ini menjadi .env lalu isi dengan data proyek Supabase.
# Tanpa .env yang valid, aplikasi berjalan dalam "Mode demo (data contoh)".
#
# PENTING: isi HANYA anon/publishable key. JANGAN PERNAH memasukkan
# service_role / secret key ke frontend. Aplikasi akan menolaknya.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
